# =============================================================================
# Telegram CRM — environment template
# =============================================================================
# Copy to `.env` and fill in real values locally.  NEVER commit `.env`.
#   cp .env.example .env
#
# Every value below is a PLACEHOLDER. No real secret belongs in this file.
# In CI/CD these come from GitHub Secrets (see README → "GitHub Secrets").
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# -----------------------------------------------------------------------------
# PostgreSQL  (service name `db` inside docker-compose)
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=telegram_crm
POSTGRES_USER=telegram_crm
POSTGRES_PASSWORD=change-me-in-local-env

# Full connection string used by the API (overrides the parts above if set)
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=telegram_crm;Username=telegram_crm;Password=change-me-in-local-env

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# Bot token from @BotFather. Format: <bot_id>:<secret>
TELEGRAM_BOT_TOKEN=000000000:REPLACE_WITH_BOTFATHER_TOKEN

# Secret token for Telegram webhook verification (F-01).
# Sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header; the API must
# reject webhook calls whose header does not match. Generate:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# Must be at least 32 characters of high-entropy data.
# Generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
JWT_ISSUER=telegram-crm
JWT_AUDIENCE=telegram-crm-web
JWT_ACCESS_TOKEN_MINUTES=60

# -----------------------------------------------------------------------------
# Frontend (build-time, Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1

# -----------------------------------------------------------------------------
# Reverse proxy
# -----------------------------------------------------------------------------
PROXY_HTTP_PORT=8080
