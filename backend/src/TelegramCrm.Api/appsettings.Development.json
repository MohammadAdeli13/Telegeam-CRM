{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Auth": {
    "InitDataMaxAgeSeconds": 300,
    "JwtLifetimeMinutes": 60,
    "AllowDevBypass": true
  },
  "Jwt": {
    "Issuer": "telegram-crm",
    "Audience": "telegram-crm-web",
    "Secret": "development-only-signing-key-at-least-32-bytes-long"
  }
}
