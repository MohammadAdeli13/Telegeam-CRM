# EF Core migrations are machine-generated by `dotnet ef migrations add`.
# They are regenerated, never hand-edited, so the repository's code-style and
# quality analyzers (which are errors under TreatWarningsAsErrors) are disabled
# for this folder only. Production code keeps every rule.
#
# Owner: Agent 2 (Backend). Scope: backend/src/TelegramCrm.Infrastructure/Persistence/Migrations.

[*.cs]

dotnet_diagnostic.IDE0005.severity = none   # unnecessary using directive
dotnet_diagnostic.IDE0161.severity = none   # file-scoped namespace preference
dotnet_diagnostic.IDE0300.severity = none   # collection expression preference
dotnet_diagnostic.IDE0301.severity = none
dotnet_diagnostic.IDE0305.severity = none
dotnet_diagnostic.CA1861.severity = none    # constant array arguments
dotnet_diagnostic.CA1862.severity = none
dotnet_diagnostic.CA1305.severity = none    # IFormatProvider
dotnet_diagnostic.CA1707.severity = none    # underscores in member names
dotnet_diagnostic.CA1062.severity = none    # null-check parameters
dotnet_diagnostic.CA1819.severity = none    # properties should not be write-only
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1600.severity = none
